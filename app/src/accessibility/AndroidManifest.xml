<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the main manifest only when the build has the Gradle property avg.accessibility=true.
     See app/build.gradle.kts. The default build does not have the accessibility service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Non-root backend 2: accessibility key interception -->
        <service
            android:name=".accessibility.AgpAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
